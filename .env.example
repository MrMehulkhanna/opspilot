# Copy to .env and adjust. Docker Compose reads this file automatically.
DATABASE_URL=sqlite:///opspilot.db
SECRET_KEY=change-me
# Leave empty to keep the REST API open on a trusted network.
OPSPILOT_API_KEY=
# Optional: enables LLM triage. Without it the rule-based triager is used.
ANTHROPIC_API_KEY=
OPSPILOT_LLM_MODEL=claude-haiku-5-5
OPSPILOT_SPIKE_WINDOW_SECONDS=60
OPSPILOT_SPIKE_THRESHOLD=10
OPSPILOT_SEED_DEMO=1
